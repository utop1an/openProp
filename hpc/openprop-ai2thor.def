Bootstrap: docker
From: ubuntu:24.04

%labels
    org.opencontainers.image.title OpenProp AI2-THOR capture runtime
    org.opencontainers.image.version 3
    python.version 3.12
    ai2thor.version 5.0.0

%files
    hpc/requirements-ai2thor.txt /opt/openprop/requirements-ai2thor.txt

%post
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash ca-certificates curl libasound2t64 libgl1 libglib2.0-0t64 libnss3 \
        libsm6 libvulkan1 libx11-6 libxcursor1 libxext6 libxi6 \
        libxinerama1 libxrandr2 libxrender1 python3 python3-pip python3-venv \
        vulkan-tools
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/openprop-venv
    /opt/openprop-venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/openprop-venv/bin/python -m pip install --no-cache-dir -r /opt/openprop/requirements-ai2thor.txt
    # SingularityCE 3.5 cannot create file-level NVIDIA bind destinations.
    # These placeholders are replaced by the matching host files at runtime.
    mkdir -p /usr/share/vulkan/icd.d /usr/share/glvnd/egl_vendor.d
    touch /usr/share/vulkan/icd.d/nvidia_icd.json
    touch /usr/share/glvnd/egl_vendor.d/10_nvidia.json

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PATH=/opt/openprop-venv/bin:$PATH
    export PYTHONPATH=/work/src
    export MPLBACKEND=Agg
    export MPLCONFIGDIR=/tmp/openprop-matplotlib
    export AI2THOR_PLATFORM=CloudRendering
    export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

%runscript
    exec python "$@"

%test
    python -c "import ai2thor; assert ai2thor.__version__ == '5.0.0'"
    python -c "import matplotlib, openai, PIL"
    test -e /usr/share/vulkan/icd.d/nvidia_icd.json
    test -e /usr/share/glvnd/egl_vendor.d/10_nvidia.json
    vulkaninfo --summary >/dev/null 2>&1 || true
